
import wollok.game.*
import personaje.*
import granja.*
import cultivos.*
describe "Tests de Granjavilla - Personaje y Parte 1 (Sembrar)" {

  method initialize() {
    game.clear()
    personaje.position(game.at(5, 5))
    granja.cultivos().clear()
  }

  test "1. Cambio de género e imagen del personaje" {
    assert.equals("f-player-normal.png", personaje.image())

    personaje.cambiarGenero()
    assert.equals("m-player-normal.png", personaje.image())

    personaje.cambiarGenero()
    assert.equals("f-player-normal.png", personaje.image())
  }

  test "2. Imagen del personaje mirando hacia abajo cuando hay un cultivo debajo" {
    assert.equals("f-player-normal.png", personaje.image())

    personaje.sembrarTomaco()

    assert.equals("f-player-abajo.png", personaje.image())
  }

  test "3. Ejemplo completo de la Parte 1: Sembrar" {
    assert.equals(game.at(5, 5), personaje.position())

    personaje.sembrarTomaco()

    assert.equals(game.at(5, 5), tomaco.position())

    assert.equals(#{tomaco}, granja.cultivos())

    assert.throwsException({ personaje.sembrarTrigo() })

    personaje.position(game.at(6, 6))

    assert.throwsException({ personaje.sembrarTomaco() })

    personaje.sembrarTrigo()

    assert.equals(game.at(6, 6), trigo.position())

    assert.equals(#{tomaco, trigo}, granja.cultivos())
  }

}
